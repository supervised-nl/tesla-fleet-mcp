# Copy to .env (never commit) or export in your process manager.

TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://your.domain/callback
TESLA_AUDIENCE=https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_REGION=eu
TESLA_CACHE_PATH=./token-cache.json
# TESLA_VIN=
# TESLA_COMMAND_BASE=https://127.0.0.1:4443
# NODE_EXTRA_CA_CERTS=./tls-cert.pem

# HTTP MCP (Grok Bot / Cursor Cloud). Not a Tesla Fleet or Tessie token.
# TESLA_MCP_TOKEN=
# TESLA_MCP_HOST=0.0.0.0
# TESLA_MCP_PORT=8787
# MCP_TRANSPORT=http
